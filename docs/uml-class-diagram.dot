digraph UML {
graph [rankdir=TB, fontname="Helvetica", nodesep=0.35, ranksep=0.6, compound=true, label="E-Commerce Fulfillment - UML class diagram (Assignment 4)", labelloc=t, fontsize=18];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9];
subgraph cluster_app { label="fulfillment.app (Client)"; style=dashed; Main [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f3f3f3"><TR><TD BORDER="0"><I>«client»</I></TD></TR><TR><TD BORDER="0"><B>Main</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">- orders: OrderFulfillmentFacade<BR ALIGN="LEFT"/>- admin: FulfillmentAdminFacade<BR ALIGN="LEFT"/></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ main(args)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];}
subgraph cluster_f { label="fulfillment.facade"; style=dashed; OFF [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff3d6"><TR><TD BORDER="0"><I>«facade»</I></TD></TR><TR><TD BORDER="0"><B>OrderFulfillmentFacade</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">- inventory, warehouse, shipping<BR ALIGN="LEFT"/>- workflow: WorkflowStore<BR ALIGN="LEFT"/>- compensator: Compensator<BR ALIGN="LEFT"/></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ placeOrder(OrderRequest): OrderRecord<BR ALIGN="LEFT"/>+ startOrder(OrderRequest): OrderRecord<BR ALIGN="LEFT"/>+ resume(orderId): OrderRecord<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; FAF [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff3d6"><TR><TD BORDER="0"><I>«facade»</I></TD></TR><TR><TD BORDER="0"><B>FulfillmentAdminFacade</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">- inventory, warehouse, shipping<BR ALIGN="LEFT"/>- workflow: WorkflowStore<BR ALIGN="LEFT"/>- compensator: Compensator<BR ALIGN="LEFT"/></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ listOrders(), listInterruptedOrders()<BR ALIGN="LEFT"/>+ inspectOrder(orderId): String<BR ALIGN="LEFT"/>+ compensateManually(orderId): List<BR ALIGN="LEFT"/>+ stockLevels(), cardBalances()<BR ALIGN="LEFT"/>+ blockShelfBin(sku), unblockShelfBin(sku)<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; COMP [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff3d6"><TR><TD BORDER="0"><B>Compensator</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">~ compensate(orderId, reason): List&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; WS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff3d6"><TR><TD BORDER="0"><I>«persistence»</I></TD></TR><TR><TD BORDER="0"><B>WorkflowStore</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">- file: workflow_orders.csv<BR ALIGN="LEFT"/></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ nextOrderId(), findOrder(id)<BR ALIGN="LEFT"/>+ findAll(), save(OrderRecord)<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; OR [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff3d6"><TR><TD BORDER="0"><I>«entity»</I></TD></TR><TR><TD BORDER="0"><B>OrderRecord</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">- orderId, sku, quantity, city, cardId<BR ALIGN="LEFT"/>- itemsTotal: int<BR ALIGN="LEFT"/>- status: PENDING_B | PENDING_C |<BR ALIGN="LEFT"/>   COMPLETED | COMPENSATED | REJECTED<BR ALIGN="LEFT"/></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ moveTo(Status, message)<BR ALIGN="LEFT"/>+ isInterrupted(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; REQ [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff3d6"><TR><TD BORDER="0"><I>«record»</I></TD></TR><TR><TD BORDER="0"><B>OrderRequest</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">sku, quantity, city, cardId<BR ALIGN="LEFT"/></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>]; ORE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff3d6"><TR><TD BORDER="0"><I>«exception»</I></TD></TR><TR><TD BORDER="0"><B>OrderRejectedException</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>]; OFE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff3d6"><TR><TD BORDER="0"><I>«exception»</I></TD></TR><TR><TD BORDER="0"><B>OrderFailedException</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">- compensationSteps: List&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];}
subgraph cluster_a { label="Subsystem A: fulfillment.inventory"; style=filled; fillcolor="#f5f9ff"; IM [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e3f0ff"><TR><TD BORDER="0"><I>«service»</I></TD></TR><TR><TD BORDER="0"><B>InventoryManager</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ reserve(orderId, sku, qty)<BR ALIGN="LEFT"/>+ release(orderId)<BR ALIGN="LEFT"/>+ markSold(orderId)<BR ALIGN="LEFT"/>+ findReservation(id), stockLevels()<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; OV [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e3f0ff"><TR><TD BORDER="0"><I>«business logic»</I></TD></TR><TR><TD BORDER="0"><B>OrderValidator</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ validate(sku, qty)<BR ALIGN="LEFT"/>+ hasEnoughStock(avail, req)<BR ALIGN="LEFT"/>+ totalPrice(price, qty)<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; IS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e3f0ff"><TR><TD BORDER="0"><I>«persistence»</I></TD></TR><TR><TD BORDER="0"><B>InventoryStore</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">inventory_stock.csv<BR ALIGN="LEFT"/>inventory_reservations.csv<BR ALIGN="LEFT"/></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ getQuantity/setQuantity(sku)<BR ALIGN="LEFT"/>+ findReservation, saveReservation<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; SR [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e3f0ff"><TR><TD BORDER="0"><I>«entity»</I></TD></TR><TR><TD BORDER="0"><B>StockReservation</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">- status: RESERVED | SOLD | RELEASED<BR ALIGN="LEFT"/></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ markSold()<BR ALIGN="LEFT"/>+ release()<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; IE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e3f0ff"><TR><TD BORDER="0"><I>«exception»</I></TD></TR><TR><TD BORDER="0"><B>InventoryException</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];}
subgraph cluster_b { label="Subsystem B: fulfillment.warehouse"; style=filled; fillcolor="#f6fbf6"; WP [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f7e6"><TR><TD BORDER="0"><I>«service»</I></TD></TR><TR><TD BORDER="0"><B>WarehousePicker</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ pickAndPack(orderId, sku, qty)<BR ALIGN="LEFT"/>+ cancelTask(orderId): boolean<BR ALIGN="LEFT"/>+ blockShelfBin / unblockShelfBin<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; PS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f7e6"><TR><TD BORDER="0"><I>«business logic»</I></TD></TR><TR><TD BORDER="0"><B>PackingStation</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ chooseBox(qty): String<BR ALIGN="LEFT"/>+ pack(PickTask)<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; WST [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f7e6"><TR><TD BORDER="0"><I>«persistence»</I></TD></TR><TR><TD BORDER="0"><B>WarehouseStore</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">warehouse_tasks.csv<BR ALIGN="LEFT"/>warehouse_blocked_bins.csv<BR ALIGN="LEFT"/></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ findTask, saveTask<BR ALIGN="LEFT"/>+ isBlocked, blockSku, unblockSku<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; PT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f7e6"><TR><TD BORDER="0"><I>«entity»</I></TD></TR><TR><TD BORDER="0"><B>PickTask</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">- status: CREATED | PICKED |<BR ALIGN="LEFT"/>   PACKED | CANCELLED<BR ALIGN="LEFT"/></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ pick()<BR ALIGN="LEFT"/>+ pack(boxSize)<BR ALIGN="LEFT"/>+ cancel()<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; WE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f7e6"><TR><TD BORDER="0"><I>«exception»</I></TD></TR><TR><TD BORDER="0"><B>WarehouseException</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];}
subgraph cluster_c { label="Subsystem C: fulfillment.shipping"; style=filled; fillcolor="#fff7f7"; SCA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fde8e8"><TR><TD BORDER="0"><I>«service»</I></TD></TR><TR><TD BORDER="0"><B>ShippingCarrierApi</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">SERVED_CITIES<BR ALIGN="LEFT"/></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ ship(orderId, card, city, total, qty)<BR ALIGN="LEFT"/>+ cancelShipment(orderId): boolean<BR ALIGN="LEFT"/>+ shippingCost(qty), cardBalances()<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; PG [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fde8e8"><TR><TD BORDER="0"><I>«business logic»</I></TD></TR><TR><TD BORDER="0"><B>PaymentGateway</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ isApproved(balance, amount)<BR ALIGN="LEFT"/>+ authorize(card, balance, amount)<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; SS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fde8e8"><TR><TD BORDER="0"><I>«persistence»</I></TD></TR><TR><TD BORDER="0"><B>ShippingStore</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">shipping_shipments.csv<BR ALIGN="LEFT"/>shipping_cards.csv<BR ALIGN="LEFT"/></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ getBalance, saveCard<BR ALIGN="LEFT"/>+ findShipment, saveShipment<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; SH [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fde8e8"><TR><TD BORDER="0"><I>«entity»</I></TD></TR><TR><TD BORDER="0"><B>Shipment</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">- status: CREATED | PAID |<BR ALIGN="LEFT"/>   SHIPPED | CANCELLED<BR ALIGN="LEFT"/></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT">+ markPaid()<BR ALIGN="LEFT"/>+ ship(tracking)<BR ALIGN="LEFT"/>+ cancel()<BR ALIGN="LEFT"/></TD></TR></TABLE>>]; SE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fde8e8"><TR><TD BORDER="0"><I>«exception»</I></TD></TR><TR><TD BORDER="0"><B>ShippingException</B></TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD BORDER="1" SIDES="T" ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];}
Main -> OFF [arrowhead=vee, label="uses"];
Main -> FAF [arrowhead=vee, label="uses"];
Main -> REQ [style=dashed, arrowhead=vee, label="creates"];
OFF -> IM [arrowhead=vee];
OFF -> WP [arrowhead=vee];
OFF -> SCA [arrowhead=vee];
OFF -> WS [arrowhead=vee];
OFF -> COMP [arrowhead=vee];
FAF -> IM [arrowhead=vee];
FAF -> WP [arrowhead=vee];
FAF -> SCA [arrowhead=vee];
FAF -> WS [arrowhead=vee];
FAF -> COMP [arrowhead=vee];
COMP -> IM [arrowhead=vee, label="3. release"];
COMP -> WP [arrowhead=vee, label="2. cancelTask"];
COMP -> SCA [arrowhead=vee, label="1. cancelShipment"];
COMP -> WS [arrowhead=vee];
WS -> OR [style=dashed, arrowhead=vee, label="stores"];
OFF -> ORE [style=dashed, arrowhead=vee, label="throws"];
OFF -> OFE [style=dashed, arrowhead=vee, label="throws"];
IM -> OV [arrowhead=vee];
IM -> IS [arrowhead=vee];
IS -> SR [style=dashed, arrowhead=vee, label="stores"];
IM -> IE [style=dashed, arrowhead=vee, label="throws"];
WP -> PS [arrowhead=vee];
WP -> WST [arrowhead=vee];
WST -> PT [style=dashed, arrowhead=vee, label="stores"];
WP -> WE [style=dashed, arrowhead=vee, label="throws"];
